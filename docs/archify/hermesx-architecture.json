  "cards": [
    {
      "dot": "cyan",
      "title": "主请求路径 (按需个股分析)",
      "items": [
        "请求: 客户端 / IM → REST /api/v1 → 编排(行情+资讯) → LLM 观点 → 落库 → 日报推送",
        "端点: watchlist · portfolio · history · alerts · analysis · agent · backtest; 单股失败隔离(线程池+全局异常)"
      ]
    },
    {
      "dot": "violet",
      "title": "定时与后台",
      "items": [
        "scheduler.py: 每日个股分析 + 大盘复盘; runtime_scheduler / alert_worker 扫描告警",
        "GitHub Actions 00-daily-analysis.yml: 工作日 18:00 (UTC+8) 跑 main.py"
      ]
    },
    {
      "dot": "amber",
      "title": "外部依赖",
      "items": [
        "行情多源 fallback: Tushare · AkShare · Tencent · baostock · yfinance 等; 资讯/事件: Brave · Tavily · SearXNG",
        "LLM: GEMINI_API_KEY / GENERATION_BACKEND / LiteLLM / local_cli; AGENT_BACKEND 可接 Codex"
      ]
    },
    {
      "dot": "rose",
      "title": "归属与信任边界",
      "items": [
        "区域 = 本仓库服务端运行时; hrs-web / hrs-desktop 同为本仓库前端, 部署于用户设备",
        "认证面: api 中间件 JWT · API-Key; Bot 平台密钥校验; 密钥走 .env / CI secrets / Docker env"
      ]
    }
